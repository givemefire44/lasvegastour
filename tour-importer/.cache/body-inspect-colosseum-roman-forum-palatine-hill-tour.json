        {
          "_key": "9xggy0030",
          "_type": "span",
          "marks": [],
          "text": "The Palatine Hill served as the exclusive residential district for Roman emperors, where Augustus established the tradition of imperial palace construction that continued for centuries."
        }
      ],
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "xj7tn9985",
